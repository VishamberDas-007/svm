model UpiPayment {
    paymentId String   @id @default(uuid())
    bookingId String
    booking   Booking  @relation(fields: [bookingId], references: [bookingId])
    upiId     String
    amount    Float
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Booking {
    bookingId  String       @id
    upiPayment UpiPayment[]
}
