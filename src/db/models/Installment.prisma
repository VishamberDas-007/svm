model Installment {
    installmentId  String        @id @default(uuid())
    // name          String
    bookingId      String
    booking        Booking       @relation(fields: [bookingId], references: [bookingId])
    amount         Int
    paymentType    IPaymentType
    installmentNo  Int
    adminAccountId Int?
    adminAccount   AdminAccount? @relation(fields: [adminAccountId], references: [adminAccountId])
    penalty        Int?
    isDelete       Boolean       @default(false)
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    @@unique([bookingId, installmentNo])
}

model Booking {
    bookingId   String        @id
    installment Installment[]
}

model AdminAccount {
    adminAccountId Int           @id
    installment    Installment[]
}

enum IPaymentType {
    CHEQUE
    UPI
    CASH
    BANK_TRANSFER
}
