model MiscExpense {
    miscExpenseId String   @id @default(uuid())
    expenseName   String
    cost          Int
    projectId     String
    project       Project  @relation(fields: [projectId], references: [projectId])
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
}

model Project {
    projectId   String        @id
    miscExpense MiscExpense[]
}
