model User {
    userId    String   @id @default(uuid())
    name      String
    email     String   @unique
    phone     String
    password  String
    address   String?
    isAdmin   Boolean  @default(false)
    roleId    Int
    role      Role     @relation(fields: [roleId], references: [roleId])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Role {
    roleId Int    @id
    user   User[]
}
