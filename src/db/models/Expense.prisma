model Expense {
    expenseId         String   @id @default(uuid())
    landPurchase      Int
    nonAgricultural   Int
    planningAndLayout Int
    landDevelopment   Int
    brokerage         Int
    landVisitCharge   Int
    projectId         String   @unique
    project           Project  @relation(fields: [projectId], references: [projectId])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

model Project {
    projectId String   @id
    expense   Expense?
}
