enum GroupType {
    ADMIN_ACCOUNT
    BOOKING
    PROJECT
    CUSTOMER
    EXPENSE
    ROLE
    USER
    INSTALLMENT
    REFERRAL
}

model Permission {
    permissionId Int       @id @default(autoincrement())
    label        String
    value        String
    role         Role[]
    group        GroupType @default(PROJECT)
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
}

model Role {
    roleId     Int          @id
    permission Permission[]
}
