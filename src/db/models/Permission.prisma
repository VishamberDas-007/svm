enum GroupType {
    ADMIN_ACCOUNT
    BOOKING
    PROJECT
    CUSTOMER
    EXPENSE
    ROLE
    USER
    INSTALLMENT
    REFERRAL
}

model Permission {
    permissionId Int      @id @default(autoincrement())
    label        String
    value        String
    role         Role[]
    group        String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}

model Role {
    roleId     Int          @id
    permission Permission[]
}
