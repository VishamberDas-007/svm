model IBankPayment {
    paymentId     String      @id @default(uuid())
    installmentId String
    installment   Installment @relation(fields: [installmentId], references: [installmentId])
    bankName      String
    accountNumber String
    amount        Float
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
}

model Installment {
    installmentId String         @id
    bankPayment   IBankPayment[]
}
