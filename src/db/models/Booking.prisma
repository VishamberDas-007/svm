model Booking {
    bookingId        String        @id @default(uuid())
    projectId        String
    project          Project       @relation(fields: [projectId], references: [projectId])
    plotNo           String
    area             Float
    totalAmt         Float
    paidAmt          Float
    remainAmt        Float
    installmentAmt   Float
    paymentType      PaymentType   @default(CASH)
    paymentStatus    PaymentStatus @default(PARTIAL)
    // customerId       String
    // customer         Customer      @relation(fields: [customerId], references: [customerId])
    adminAccountId   Int?
    adminAccount     AdminAccount? @relation(fields: [adminAccountId], references: [adminAccountId])
    reminderDate     DateTime
    installmentDate  DateTime
    installmentCount Int
    dastavejAmt      Float
    refundAmt        Float?
    referralId       String?
    referral         Referral?     @relation(fields: [referralId], references: [referralId])
    isDelete         Boolean       @default(false)
    createdAt        DateTime      @default(now())
    updatedAt        DateTime      @updatedAt
}

model Project {
    projectId String    @id
    booking   Booking[]
}

// model Customer {
//     customerId String    @id
//     booking    Booking[]
// }

model AdminAccount {
    adminAccountId Int       @id
    booking        Booking[]
}

model Referral {
    referralId String    @id
    booking    Booking[]
}

enum PaymentStatus {
    PENDING
    PARTIAL
    CANCEL
    COMPLETED
}

enum PaymentType {
    CHEQUE
    UPI
    CASH
    BANK_TRANSFER
}
