model IUpiPayment {
    paymentId     String   @id @default(uuid())
    installmentId String
    installment   Booking  @relation(fields: [installmentId], references: [installmentId])
    upiId         String
    amount        Float
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
}

model Booking {
    installmentId String        @id
    upiPayment    IUpiPayment[]
}
