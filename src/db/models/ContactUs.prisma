model ContactUs {
    contactUsId String          @id @default(uuid())
    email       String?
    name        String
    message     String
    number      String
    subject     String
    status      ContactUsStatus @default(PENDING)
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
}

enum ContactUsStatus {
    PENDING
    COMPLETED
}
