model ICashPayment {
    paymentId     String      @id @default(uuid())
    installmentId String
    installment   Installment @relation(fields: [installmentId], references: [installmentId])
    amount        Float
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
}

model Installment {
    installmentId String         @id
    cashPayment   ICashPayment[]
}
