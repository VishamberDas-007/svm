model ChequePayment {
    paymentId    String   @id @default(uuid())
    bookingId    String
    booking      Booking  @relation(fields: [bookingId], references: [bookingId])
    chequeNumber String
    bankName     String
    amount       Float
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}

model Booking {
    bookingId     String          @id
    chequePayment ChequePayment[]
}
