model Customer {
    customerId String   @id @default(uuid())
    name       String
    aadharNo   String   @unique
    phone1     String
    phone2     String?
    email      String?
    address    String?
    pincode    String
    city       String
    state      String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}
