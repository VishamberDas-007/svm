model Customer {
    customerId String    @id @default(uuid())
    name       String
    phone1     String
    phone2     String?
    email      String?
    address    String?
    pincode    String
    city       String
    state      String
    booking    Booking[]
    dob        DateTime?
    isMarried  Boolean   @default(false)
    isDelete   Boolean   @default(false)
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
}

model Booking {
    bookingId String     @id
    customer  Customer[]
}
