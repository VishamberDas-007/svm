{
    "name": "svm-backend",
    "version": "1.0.0",
    "description": "This is SVM developers backend in typescript",
    "main": "server.js",
    "author": "Vishamber Das",
    "license": "MIT",
    "prisma": {
        "schema": "./src/db/schema.prisma"
    },
    "scripts": {
        "prismix": "npx prismix",
        "sync": "npx prismix",
        "client-gen": "yarn prisma generate",
        "migration": "prismix && prisma migrate dev && prisma generate",
        "migrate": "yarn prisma migrate dev --create-only",
        "migrate:deploy": "yarn prisma migrate deploy",
        "prisma:dev": "dotenv -e .env.dev -- yarn prisma",
        "seed": "node ./src/scripts/MasterSeeder.js",
        "start": "cross-env APP_ENV=LOCAL nodemon --files src/index.ts",
        "start:dev": "cross-env APP_ENV=DEV nodemon --files src/index.ts",
        "start:prod": "cross-env APP_ENV=PRODUCTION nodemon --files src/index.ts",
        "build": "tsc",
        "serve": "node ./dist/index.js",
        "lint": "eslint . --ext .ts",
        "watch": "tsc -w",
        "prepare": "husky install"
    },
    "dependencies": {
        "@prisma/client": "^4.7.1",
        "@types/express-list-endpoints": "^6.0.0",
        "@types/nodemailer": "^6.4.7",
        "aws-sdk": "^2.1272.0",
        "axios": "^1.2.6",
        "bcrypt": "^5.1.0",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-list-endpoints": "^6.0.0",
        "google-auth-library": "^8.7.0",
        "http-status": "^1.5.3",
        "joi": "^17.7.0",
        "jsonwebtoken": "^9.0.0",
        "moment": "^2.29.4",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^6.8.0",
        "path": "^0.12.7",
        "prismix": "^1.0.22",
        "typescript": "^4.5.2",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.0",
        "@types/cookie-parser": "^1.4.3",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.13",
        "@types/joi": "^17.2.3",
        "@types/jsonwebtoken": "^8.5.9",
        "@types/morgan": "^1.9.3",
        "@types/multer": "^1.4.7",
        "@typescript-eslint/eslint-plugin": "^5.4.0",
        "@typescript-eslint/parser": "^5.4.0",
        "concurrently": "^7.6.0",
        "cross-env": "^7.0.3",
        "dotenv-cli": "^6.0.0",
        "eslint": "^8.24.0",
        "eslint-config-prettier": "^8.5.0",
        "husky": "^8.0.0",
        "nodemon": "^2.0.15",
        "prettier": "^2.8.1",
        "prettier-plugin-prisma": "^4.8.0",
        "prisma": "^4.7.1",
        "ts-node": "^10.9.1"
    }
}
